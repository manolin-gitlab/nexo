[Unit]
Description=Nexo IPTV central catalog API
After=network.target

[Service]
Type=simple
User=nexo-api
Group=nexo-api
EnvironmentFile=/etc/nexo-api.env
ExecStart=/usr/bin/python3 /opt/nexo-iptv/backend/nexo_api.py
StateDirectory=nexo-iptv
StateDirectoryMode=0700
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077

[Install]
WantedBy=multi-user.target
