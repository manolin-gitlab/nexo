# Merge into a dedicated HTTPS virtual host with an existing valid certificate.
# Replace the hostname and certificate paths. Do not overwrite your streaming configuration.
server {
    listen 443 ssl;
    server_name metricas.tu-dominio.com;
    ssl_certificate /ruta/al/certificado/fullchain.pem;
    ssl_certificate_key /ruta/a/la/clave/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    access_log off;
    location = /v1/snapshot {
        proxy_pass http://127.0.0.1:9108;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Origin $http_origin;
        proxy_hide_header X-Powered-By;
        proxy_read_timeout 5s;
        add_header Cache-Control "no-store" always;
    }
    location = /healthz {
        proxy_pass http://127.0.0.1:9108;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Origin $http_origin;
    }
    location / { return 404; }
}
